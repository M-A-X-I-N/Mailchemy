{
    "name": "mailchemy-workspace",
    "private": true,
    "type": "module",
    "packageManager": "npm@11.20.0",
    "engines": {
        "node": "24.21.x",
        "npm": "11.20.x"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "tsc -b",
        "typecheck": "npm run build && tsc -p tsconfig.test.json --noEmit",
        "lint": "eslint \"packages/**/*.ts\" --max-warnings=0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "npm run build && vitest run",
        "check": "npm run typecheck && npm run lint && npm run format:check && vitest run"
    },
    "devDependencies": {
        "typescript": "6.0.3",
        "vitest": "5.0.1",
        "@eslint/js": "10.0.1",
        "eslint": "10.11.0",
        "typescript-eslint": "8.70.1",
        "prettier": "3.9.9"
    }
}
